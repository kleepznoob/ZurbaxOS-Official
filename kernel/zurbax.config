# Zurbax kernel configuration fragment
# Applied on top of x86_64_defconfig by kernel/build.sh.
# Everything is built in: Zurbax has no module loader, so the kernel plus the
# embedded system image form one self-contained EFI executable.

# ---- Identity -------------------------------------------------------------
CONFIG_EXPERT=y
CONFIG_LOCALVERSION="-zos"
CONFIG_DEFAULT_HOSTNAME="zos"
# CONFIG_MODULES is not set
# CONFIG_LOCALVERSION_AUTO is not set

# ---- Responsiveness (desktop + gaming) ------------------------------------
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZSWAP=y

# ---- Direct EFI boot, no bootloader ----------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_ZSTD=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=1 snd_intel_dspcfg.dsp_driver=1"

# ---- Smooth boot: never draw text over the firmware logo ------------------
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_LOGO is not set
# CONFIG_VGA_CONSOLE is not set
CONFIG_ACPI_BGRT=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# ---- Core userspace interfaces ---------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_FUTEX=y
CONFIG_UNIX98_PTYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# ---- App sandboxing --------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
# Unprivileged user namespaces: Steam's container runtime (pressure-vessel)
# and the sandbox of its Chromium-based interface start programs in them.
CONFIG_USER_NS=y

# ---- Running Windows games (Proton/Wine) ------------------------------------
# ntsync: Windows-style synchronization in the kernel, Wine's fast path.
CONFIG_NTSYNC=y

# ---- Graphics --------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
# Vulkan drivers map programs' own memory into the GPU (host-memory imports).
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y

# ---- Input: keyboards, mice, laptop touchpads -------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_ASUS=y
CONFIG_I2C=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_PIIX4=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_AMD=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=n
CONFIG_ACPI_WMI=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_INTEL_HID_EVENT=y
CONFIG_VIRTIO_INPUT=y

# ---- Game controllers: Xbox (and its wireless USB receiver), PlayStation,
# Switch Pro, Steam and generic USB pads, with rumble and battery levels ----
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_PID=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_STEAM=y
CONFIG_STEAM_FF=y
CONFIG_HID_LOGITECH=y
CONFIG_LOGITECH_FF=y
CONFIG_HID_GOOGLE_STADIA_FF=y
# Steam Input reads controllers through hidraw and offers games a virtual
# Xbox controller through uinput; uhid is the same for HID devices.
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y

# ---- Storage ----------------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_VMD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

# ---- Filesystems ------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
# the Linux layer (Steam, Proton) comes as one compressed, read-only image
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- USB --------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB4=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y

# ---- Webcams ----------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y

# ---- Sound ------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_ALC662=y
CONFIG_SND_HDA_CODEC_ALC882=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_SENARYTECH=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI_ATI=y
CONFIG_SND_HDA_CODEC_HDMI_NVIDIA=y
CONFIG_SND_USB_AUDIO=y

# ---- Networking -------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_VIRTIO_NET=y
CONFIG_RFKILL=y
# Wi-Fi firmware is stored xz-compressed in /lib/firmware
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
CONFIG_MT7921E=y
CONFIG_MT7925E=y
CONFIG_RTW89=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852CE=y
CONFIG_RTW89_8922AE=y

# ---- Power, battery, thermals ----------------------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y

# ---- Developer console (QEMU serial only; nothing on screen) ---------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
