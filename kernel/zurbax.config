# Zurbax kernel configuration fragment
# Applied on top of x86_64_defconfig by kernel/build.sh.
# Everything is built in: Zurbax has no module loader, so the kernel plus the
# embedded system image form one self-contained EFI executable.

# ---- Identity -------------------------------------------------------------
CONFIG_EXPERT=y
CONFIG_LOCALVERSION="-zurbax"
CONFIG_DEFAULT_HOSTNAME="zurbax"
# CONFIG_MODULES is not set
# CONFIG_LOCALVERSION_AUTO is not set

# ---- Responsiveness (desktop + gaming) ------------------------------------
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZSWAP=y

# ---- Direct EFI boot, no bootloader ----------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_ZSTD=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=1 slab_nomerge snd_intel_dspcfg.dsp_driver=1 nouveau.config=NvGspRm=1 amdgpu.si_support=1 amdgpu.cik_support=1 radeon.si_support=0 radeon.cik_support=0"

# ---- Smooth boot: never draw text over the firmware logo ------------------
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_LOGO is not set
# CONFIG_VGA_CONSOLE is not set
# no "Decompressing Linux..." from the boot code, no early console, and the
# quiet level silences everything but emergencies (which have nowhere to go)
# CONFIG_X86_VERBOSE_BOOTUP is not set
# CONFIG_EARLY_PRINTK is not set
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=1
CONFIG_CONSOLE_LOGLEVEL_QUIET=1
CONFIG_ACPI_BGRT=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# ---- Core userspace interfaces ---------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_FUTEX=y
CONFIG_UNIX98_PTYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# ---- App sandboxing --------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="lockdown,yama,landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
# Unprivileged user namespaces: Steam's container runtime (pressure-vessel)
# and the sandbox of its Chromium-based interface start programs in them.
CONFIG_USER_NS=y

# ---- Hardening ----------------------------------------------------------------
# Protections that cost little speed: memory that's zeroed before reuse,
# randomized and checked kernel heaps, copies to and from programs checked,
# no way to rewrite the running kernel (lockdown, no kexec, no /dev/mem),
# kernel addresses and messages hidden from programs, and Yama, which stops
# one program reading another's memory unless it started it.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_KFENCE=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# no bpf() system call at all (# CONFIG_BPF_SYSCALL), so no unprivileged BPF
CONFIG_LEGACY_VSYSCALL_XONLY=y
CONFIG_X86_USER_SHADOW_STACK=y
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_DEVPORT is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_SECURITY_SELINUX is not set

# ---- Running Windows games (Proton/Wine) ------------------------------------
# ntsync: Windows-style synchronization in the kernel, Wine's fast path.
CONFIG_NTSYNC=y

# ---- Graphics --------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
# Vulkan drivers map programs' own memory into the GPU (host-memory imports).
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y
# NVIDIA through nouveau (the GSP firmware drives Turing and newer; Mesa's
# NVK gives Vulkan on top), older AMD (radeon), compute (ROCm), USB displays
# (DisplayLink, GUD), and the virtual GPUs of VMware, Hyper-V and VirtualBox
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_RADEON=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_HSA_AMD=y
CONFIG_DRM_I915_GVT=n
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_HYPERV=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_QXL=y
CONFIG_DRM_AST=y
CONFIG_DRM_UDL=y
CONFIG_DRM_GUD=y
# the AI engines of recent laptops: Intel's NPU and AMD's XDNA
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=y
CONFIG_DRM_ACCEL_AMDXDNA=y

