CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_ACPI_TAD=y
CONFIG_ACPI_DPTF=y
CONFIG_INT340X_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_AMD_PMC=y
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_TEE=y
CONFIG_AMDTEE=y
CONFIG_AMD_PMF=y
CONFIG_INTEL_VSEC=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_INTEL_PMC_CORE=y
CONFIG_INTEL_VBTN=y
CONFIG_INTEL_RST=y
# the laptop makers' own buttons, fans, keyboard lights, battery limits
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_THINKPAD_ACPI=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
# the BIOS updater needs a firmware helper program; firmware comes from files
# CONFIG_DELL_RBU is not set
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_WMI=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_WMI_DDV=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_ACER_WMI=y
CONFIG_MSI_WMI=y
CONFIG_MSI_LAPTOP=y
CONFIG_SAMSUNG_LAPTOP=y
CONFIG_SONY_LAPTOP=y
CONFIG_PANASONIC_LAPTOP=y
CONFIG_LG_LAPTOP=y
CONFIG_HUAWEI_WMI=y
CONFIG_FUJITSU_LAPTOP=y
CONFIG_ACPI_TOSHIBA=y
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR=y
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=y
CONFIG_SURFACE_HID=y
CONFIG_SURFACE_PLATFORM_PROFILE=y
CONFIG_SURFACE_GPE=y
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=y
CONFIG_CROS_EC_LPC=y
CONFIG_CROS_KBD_LED_BACKLIGHT=y
CONFIG_LEDS_TRIGGERS=y
# temperatures and fans (Settings, the system monitor)
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_SENSORS_NCT6775=y
CONFIG_SENSORS_ASUS_EC=y
CONFIG_SENSORS_DELL_SMM=y
CONFIG_SENSORS_ACPI_POWER=y
# the security chip (TPM) and the processors' random numbers
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_HW_RANDOM_TPM=y

# ---- Developer console (QEMU serial only; nothing on screen) ---------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
