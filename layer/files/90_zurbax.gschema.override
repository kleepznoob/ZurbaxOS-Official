# Zurbax's defaults for GNOME: the same picture as the Zurbax desktop, warm
# accents to match it, window buttons on the right, the Zurbax Taskbar
# (layer/files/taskbar@zurbax.org) and the apps that ship.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/zurbax/silk.png'
picture-uri-dark='file:///usr/share/backgrounds/zurbax/silk.png'
picture-options='zoom'
primary-color='#2c0a2b'
secondary-color='#5c1534'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/zurbax/silk.png'
primary-color='#2c0a2b'

[org.gnome.desktop.interface]
accent-color='orange'
color-scheme='prefer-dark'
clock-show-weekday=true
enable-hot-corners=true

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

[org.gnome.mutter]
center-new-windows=true

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true

[org.gnome.shell]
enabled-extensions=['taskbar@zurbax.org']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Console.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Settings.desktop']
