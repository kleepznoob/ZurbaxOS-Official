{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/download/(.*)\\.iso",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-iso9660-image"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/2.0/:file",
      "destination": "https://archive.org/download/zurbax-2.0/:file",
      "permanent": false
    },
    {
      "source": "/download/2.1/:file(apps.sfs|apps2.sfs|apps3.sfs|firmware.sfs)",
      "destination": "https://archive.org/download/zurbax-2.0/:file",
      "permanent": false
    },
    {
      "source": "/download/2.1/:file",
      "destination": "https://archive.org/download/zurbax-2.1/:file",
      "permanent": false
    },
    {
      "source": "/download/2.2/:file(apps.sfs|apps2.sfs|apps3.sfs|firmware.sfs)",
      "destination": "https://archive.org/download/zurbax-2.0/:file",
      "permanent": false
    },
    {
      "source": "/download/2.2/zurbax-standard.iso",
      "destination": "https://archive.org/download/zurbax-2.2-standard/zurbax-standard.iso",
      "permanent": false
    },
    {
      "source": "/download/2.2/:file",
      "destination": "https://archive.org/download/zurbax-2.2/:file",
      "permanent": false
    },
    {
      "source": "/updates/:release/:file",
      "destination": "https://archive.org/download/zurbax-updates-:release/:file",
      "permanent": false
    }
  ]
}
